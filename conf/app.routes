# deprecated routes

POST   /services/:service/features/:feature                     uk.gov.hmrc.ratelimitedallowlist.controllers.AllowListController.checkAllowList(service: Service, feature: Feature)

GET    /services                                                uk.gov.hmrc.ratelimitedallowlist.controllers.AllowListAdminController.getServices(permission: Option[ScopeLevel])
POST   /services/:service/allow-lists                           uk.gov.hmrc.ratelimitedallowlist.controllers.AllowListAdminController.create(service: Service)
GET    /services/:service/features                              uk.gov.hmrc.ratelimitedallowlist.controllers.AllowListAdminController.getFeatures(service: Service)
GET    /services/:service/features/:feature/metadata            uk.gov.hmrc.ratelimitedallowlist.controllers.AllowListAdminController.get(service: Service, feature: Feature)
PATCH  /services/:service/features/:feature/metadata            uk.gov.hmrc.ratelimitedallowlist.controllers.AllowListAdminController.patch(service: Service, feature: Feature)
POST   /services/:service/features/:feature/metadata/tokens     uk.gov.hmrc.ratelimitedallowlist.controllers.AllowListAdminController.addTokens(service: Service, feature: Feature)
GET    /services/:service/features/:feature/report              uk.gov.hmrc.ratelimitedallowlist.controllers.AllowListAdminController.getAllowListReport(service: Service, feature: Feature, queryParams: AllowListReportQueryParams)

# consumer routes
POST   /services/:service/allow-list/:allowList                       uk.gov.hmrc.ratelimitedallowlist.controllers.RateLimitedAllowListController.checkAllowList(service: Service, allowList: Feature)

# admin routes
GET    /v2/services                                             uk.gov.hmrc.ratelimitedallowlist.controllers.RateLimitedAllowListAdminController.getServices(permission: Option[ScopeLevel])
GET    /v2/services/:service                                    uk.gov.hmrc.ratelimitedallowlist.controllers.RateLimitedAllowListAdminController.getAllowLists(service: Service)

POST   /v2/services/:service/allow-lists                         uk.gov.hmrc.ratelimitedallowlist.controllers.RateLimitedAllowListAdminController.create(service: Service)

GET    /v2/services/:service/allow-lists/:allowList                uk.gov.hmrc.ratelimitedallowlist.controllers.RateLimitedAllowListAdminController.get(service: Service, allowList: Feature)
PATCH  /v2/services/:service/allow-lists/:allowList                uk.gov.hmrc.ratelimitedallowlist.controllers.RateLimitedAllowListAdminController.patch(service: Service, allowList: Feature)
DELETE /v2/services/:service/allow-lists/:allowList                uk.gov.hmrc.ratelimitedallowlist.controllers.RateLimitedAllowListAdminController.delete(service: Service, allowList: Feature)

GET    /v2/services/:service/allow-lists/:allowList/report         uk.gov.hmrc.ratelimitedallowlist.controllers.RateLimitedAllowListAdminController.getAllowListReport(service: Service, allowList: Feature)
